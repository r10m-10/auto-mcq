{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "deny",
      "website/**": "allow",
      "backend/app/routers/website.py": "allow",
      "backend/app/routers/offerwall.py": "allow",
      "backend/tests/test_website*.py": "allow",
      "backend/tests/test_offerwall*.py": "allow",
      "extension/**": "deny",
      "backend/app/models/**": "deny",
      "backend/app/core/**": "deny",
      "backend/app/routers/credits.py": "deny",
      "backend/app/routers/device.py": "deny"
    },
    "bash": {
      "*": "ask",
      "pytest*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "allow"
  }
}