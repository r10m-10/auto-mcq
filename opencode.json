{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "deny",
      "website/**": "allow",
      "backend/routers/**": "allow",
      "backend/tests/**": "allow",
      "extension/**": "deny",
      "extension copy/**": "allow",
      "AGENTS.md": "allow",
      "backend/app/**": "allow",
      "backend/main.py": "allow"
    },
    "bash": {
      "*": "ask",
      "pytest*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "rm -rf*": "deny"
    },
    "webfetch": "allow"
  }
}